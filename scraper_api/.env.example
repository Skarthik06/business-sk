# Scraper API settings (copy to .env on the server; .env is git-ignored — never commit it).
# Comma-separated API keys that may call the API (the affiliate engine uses one of them).
SCRAPER_API_KEYS=
# Fernet key that encrypts proxy credentials at rest. Empty = one is generated into /data/secret.key.
SCRAPER_SECRET_KEY=
# Optional proxy (seeded into the registry at startup). Or add proxies via POST /v1/admin/proxies.
SCRAPER_PROXY_SERVER=
SCRAPER_PROXY_USER=
SCRAPER_PROXY_PASS=
SCRAPER_PROXY_COUNTRY=IN
# Limits
SCRAPER_CONCURRENCY=8
SCRAPER_BROWSER_CONCURRENCY=2
SCRAPER_RATE_LIMIT_PER_MIN=120
