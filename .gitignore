# ============================================================================
# BUSINESS_SK — monorepo (mirrors this folder). Contains instagram_automation/
# (JK + IG backend) and affiliate-rag-bot/ (SK engine) as sub-folders.
# GOLDEN RULE: never commit secrets. Real keys live ONLY in .env / .ragskey.
# ============================================================================

# ── Secrets — NEVER commit (anywhere in the tree) ───────────────────────────
.env
**/.env
.env.*
!.env.example
!**/.env.example
!.env.phone.example
!**/.env.phone.example
.ragskey
**/.ragskey
**/*.key
**/*.pem
**/secrets.json
**/*credentials*.json
**/*CREDENTIALS*
**/*.local.txt
CREDENTIALS.local.txt

# ── Python ──────────────────────────────────────────────────────────────────
**/venv/
**/.venv/
**/env/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/

# ── Node / frontend build ───────────────────────────────────────────────────
**/node_modules/
**/dist/
**/build/
**/.vite/
**/*.local

# ── Local databases ─────────────────────────────────────────────────────────
**/*.db
**/*.sqlite
**/*.sqlite3

# ── Generated / bloat (NOT the hosting assets storefront|sk_media|images) ────
**/images/sk_slides/
instagram_automation/data-business/
**/previews/
scratch_render/
sk_samples/
engagement_conversation_full.txt
**/*.log

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
