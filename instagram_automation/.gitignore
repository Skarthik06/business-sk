# --- Secrets & local data (NEVER commit to this PUBLIC repo) ---
# .env holds the OpenAI key; posts.db holds IG access tokens;
# .ragskey is the encryption key for those tokens. None may ever be committed.
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
.ragskey

