# Copy to `.env` and fill in. NEVER commit the real .env.
# Only the LLM key + hosting config live here.
# Instagram account credentials and the News API key are managed in the
# app's Settings panel (stored in the "rags" SQLite store, not in this file).

# --- LLM (required) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# Safety ceiling on generated tokens per batch (cost guard).
LLM_MAX_OUTPUT_TOKENS=2200

# --- Database (PostgreSQL) ---
# In Docker this is injected by docker-compose (points at the `db` service).
# For LOCAL (non-Docker) dev against your own Postgres, set it here instead.
# DATABASE_URL=postgresql://instagram:instagram@localhost:5432/instagram_business

# --- Public image hosting (GitHub raw) ---
# Images are committed to this PUBLIC repo so Instagram can fetch them by URL.
GITHUB_USERNAME=your-github-username
GITHUB_REPO=instagram_automation
GITHUB_BRANCH=main

# --- Single-admin login (private app — ONE administrator, no SaaS/RBAC) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_SECRET=set-a-long-random-string-here

# --- Engagement automation platform (deterministic; live Meta is opt-in) ---
# Set to 1 ONLY when ready to send real replies/DMs; default dry-run records intent.
ENGAGEMENT_LIVE=0
# Meta webhook verification token (you choose this; enter the same value in the App
# dashboard when subscribing the webhook). Required to accept Meta webhooks.
META_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret — used to validate webhook signatures (X-Hub-Signature-256).
META_APP_SECRET=
# Background poller (pull model — no public webhook needed). Every interval it pulls
# each post's comments + insights and auto-replies to any that match a rule.
ENGAGEMENT_AUTO_SYNC=1
ENGAGEMENT_SYNC_INTERVAL=60

# --- Optional ---
IG_HANDLE=sparkle06.exe

# ── AI Stylist (styled flat-lays, paid per image — only when "✨ Style with AI" is pressed) ──
SK_STYLIST_MODEL=gpt-image-1-mini          # OpenAI image model (cheapest that keeps logos at medium)
SK_STYLIST_DAILY_CAP_USD=0.30              # never spend more than this per day
SK_STYLIST_RESERVE_USD=0.50                # stop while this much credit is still left
SK_STYLIST_CREDIT_USD=0                    # your OpenAI credit balance when you set this (0 = reserve check off)
SK_STYLIST_CREDIT_SINCE=                   # YYYY-MM-DD you read that balance (update both after a top-up)
SK_STYLIST_INPUT_PX=640                    # images sent to OpenAI are downscaled to this (input tokens = cost)
SK_STYLIST_FIDELITY_CHECK=1                # free pixel check: colour kept + wrong logo swapped for the real one
