# ─── AMAZON ASSOCIATES ────────────────────────────────────────────────
AMAZON_EMAIL=your_amazon_email@gmail.com
AMAZON_PASSWORD=your_amazon_password
AMAZON_ASSOCIATE_TAG=karu8749-21
AMAZON_MARKETPLACE=amazon.in

# ─── PINTEREST ────────────────────────────────────────────────────────
PINTEREST_EMAIL=your_pinterest_email@gmail.com
PINTEREST_PASSWORD=your_pinterest_password
PINTEREST_BOARD_NAME=Best Amazon Deals

# ─── AI & SEARCH ──────────────────────────────────────────────────────
# OpenAI / ChatGPT — used for product ranking + pin content generation
OPENAI_API_KEY=sk-proj-...         # Get at platform.openai.com/api-keys
OPENAI_MODEL=gpt-5-nano            # reasoning model — cheap, great for structured copywriting
LLM_MAX_OUTPUT_TOKENS=5000
# Reasoning-model controls (gpt-5 / o-series): minimal | low | medium | high
LLM_REASONING_EFFORT=minimal
# Low temperature to curb hallucination (applied only to NON-reasoning models)
LLM_TEMPERATURE=0.2

# Embeddings run 100% locally (free, no API key) — model name only:
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OPTIONAL — live trending keywords. Leave blank to use built-in fallback keywords.
TAVILY_API_KEY=                    # Free at app.tavily.com (optional)


# ─── STORAGE (PostgreSQL + pgvector) ─────────────────────────────────
# One database holds BOTH the vector RAG store and the dedup ledger.
# Create the DB + enable the extension once:  CREATE EXTENSION vector;
# Include the project database name at the end (/affiliate_rag_bot).
# URL-encode special chars in the password (e.g. @ -> %40, : -> %3A).
DATABASE_URL=postgresql://user:password@localhost:5432/affiliate_rag_bot
# Optional — pgvector collection name (default shown):
PGVECTOR_COLLECTION=affiliate_pins

# ─── LANGSMITH (optional — visual trace of every run) ─────────────────
LANGCHAIN_TRACING_V2=false         # set true + add a real key to enable tracing
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=affiliate-bot

# ─── BOT SETTINGS ─────────────────────────────────────────────────────
PRODUCTS_PER_RUN=3
AMAZON_CATEGORY=home
DELAY_BETWEEN_PINS=1200            # seconds (1200 = 20 min)
HEADLESS=false

# ── Scraping proxy (so a CLOUD/datacenter host can fetch Amazon past the bot-wall) ──
# Amazon blocks datacenter IPs; route the Playwright scraper through a residential
# proxy / scraping API. Free tier: ScraperAPI (https://dashboard.scraperapi.com).
# Leave unset when running from a residential IP (home PC/phone) — not needed there.
# SCRAPER_PROXY_SERVER=http://proxy-server.scraperapi.com:8001
# SCRAPER_PROXY_USER=scraperapi.country_code=in
# SCRAPER_PROXY_PASS=your_scraperapi_key
